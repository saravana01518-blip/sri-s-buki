# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB (optional for mock/stateless runs; required for persistent query logs)
MONGODB_URI=mongodb://localhost:27017/buki_sage

# Target Buki Backend URL (supports BUKI_URL, with fallback to BUKI_API_URL / BUKI_BASE_URL)
BUKI_URL=https://my-buki.onrender.com

# Internal Buki Bearer Token (clients must send Authorization: Bearer <token>)
BUKI_API_TOKEN=buki-dev-internal-token-change-me

# Set to "true" to bypass the UI token prompt and auto-authenticate using server-side BUKI_API_TOKEN
SKIP_TOKEN_PROMPT=false

# Sage API Connector
SAGE_API_URL=https://api.sage.example.com/v1/query
SAGE_API_KEY=replace-with-sage-bearer-token
SAGE_TIMEOUT_MS=3000

# Set to "false" in production or when connecting to a live Sage API endpoint
SAGE_MOCK_MODE=true
