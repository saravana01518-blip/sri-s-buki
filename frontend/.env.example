# Optional: leave blank for same-origin / Vite proxy (/api -> http://localhost:5000).
# Set to https://my-buki.onrender.com when pointing a standalone frontend at the Render backend.
# Supports VITE_BUKI_URL, VITE_API_BASE_URL, or VITE_BUKI_API_URL.
VITE_BUKI_URL=
VITE_API_BASE_URL=
# Set to "true" to skip the UI token prompt at build time
VITE_SKIP_TOKEN_PROMPT=false
